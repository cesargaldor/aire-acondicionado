<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Aire</AssemblyName>
    <RootNamespace>Aire</RootNamespace>
    <ApplicationIcon>Aire.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Aire.Program</StartupObject>
    <Version>1.0.0</Version>
    <Product>Aire</Product>
    <Description>Control local de un aire acondicionado Midea desde la bandeja del sistema</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MideaKit\MideaKit.csproj" />
    <Resource Include="Aire.ico" />
  </ItemGroup>
</Project>
